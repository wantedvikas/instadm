# Never-expiring Page access token for the Facebook Page linked to your Instagram account (see README step 3)
IG_ACCESS_TOKEN=

# Meta App Dashboard > App settings > Basic > App secret (verifies webhook signatures)
META_APP_SECRET=

# Any random string; paste the same value as "Verify token" in the webhook settings
WEBHOOK_VERIFY_TOKEN=

# Password for the dashboard, and a random cookie-signing key (`openssl rand -hex 32`)
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Set automatically when you add Upstash Redis from the Vercel Marketplace
KV_REST_API_URL=
KV_REST_API_TOKEN=
