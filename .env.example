# Your deployed URL, no trailing slash (must match the OAuth redirect URL in the Meta dashboard)
APP_URL=https://your-app.vercel.app

# Meta dashboard > your app > Instagram > API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=
# Optional: Meta dashboard > App settings > Basic > App secret (also accepted for webhook signatures)
META_APP_SECRET=

# Any random string; paste the same value as "Verify token" in the webhook settings
WEBHOOK_VERIFY_TOKEN=

# Random strings, e.g. `openssl rand -hex 32`
SESSION_SECRET=
CRON_SECRET=

# Set automatically when you add Upstash Redis from the Vercel Marketplace
KV_REST_API_URL=
KV_REST_API_TOKEN=
