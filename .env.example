# Copy to .env.local for local development. Never commit real values: every .env* file except this one is git-ignored.

# Never-expiring Page access token for the Facebook Page linked to your Instagram account (README step 6)
IG_ACCESS_TOKEN=

# Meta App Dashboard > App settings > Basic > App secret (verifies webhook signatures) (README step 3)
META_APP_SECRET=

# Any random string (openssl rand -hex 32); paste the same value as "Verify token" in the Meta webhook settings
WEBHOOK_VERIFY_TOKEN=

# Dashboard login password, and a random cookie-signing key (openssl rand -hex 32)
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Upstash Redis. Set automatically by the Vercel Marketplace integration;
# for a direct Upstash database use UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
